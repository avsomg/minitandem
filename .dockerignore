# Allow-list: everything is left out of the build context unless it is named below.
# The image is built from a clean clone. This file is the second line of defence if it is not: it must never let private state in.
*
!*.js
!*.mjs
!index.html
!styles.css
!manifest.webmanifest
!robots.txt
!vercel.json
!.vercelignore
!research.md
!assets
!docker
!editorial

# Not needed to build or to run the service
**/*.test.mjs
verify*.mjs
screenshots.mjs
prepare.mjs
playwright-loader.mjs
test-support.mjs
demo
scripts
editorial/admin-session.test.mjs

# Private paths, named again so that nothing above can let them in (same list as .gitignore and editorial/public-audit.mjs)
editorial/workflow-state
editorial/agent-artifacts
editorial/external-candidates
editorial/external-disputes
editorial/external-decisions
editorial/external-review-receipts.json
editorial/family-venues-visitor-check-2026-09-27.json
