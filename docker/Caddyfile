{
	# Contact address for certificate notices from Let's Encrypt. Set ACME_EMAIL in .env (compose.yaml refuses to start without it).
	email {$ACME_EMAIL}
	# Caddy's own messages (errors, reverse proxy, certificates) go to the container log, which Docker keeps by size, not by time.
	# An error record carries the request that caused it; its visitor fields are deleted here, not masked, so this log holds no
	# visitor address at all. Access records have their own masked, short-lived log in the site block and are left out here.
	log default {
		output stderr
		exclude http.log.access
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>remote_port delete
				request>headers delete
				request>uri delete
				request>host delete
			}
		}
	}

	# A sender that is slow to finish its request line and headers, or to deliver its body, is cut off at the edge, not kept waiting.
	# Only reads are limited: answers and idle connections keep Caddy's defaults, so a slow download is not cut.
	servers {
		timeouts {
			read_header 10s
			read_body 30s
		}
	}
}

www.minitandem.ch {
	redir https://minitandem.ch{uri} permanent
}

minitandem.ch {
	encode zstd gzip

	# The editor panel and the editor API belong to the owner's Mac. No editor key exists on this server, so the service
	# would answer 401 anyway; the edge refuses these paths as well.
	@editor path /admin /admin.js /admin.css /admin-icons.js /api/v1/admin/*
	respond @editor 404

	header {
		# One day for the first weeks. Raise it once the certificate renewal has been seen to work.
		Strict-Transport-Security "max-age=86400"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		# The page opens no window that needs a link back to it (outgoing links are noopener), and nothing of ours is meant to be loaded by another site.
		# Map tiles from wmts.geo.admin.ch are not affected: CORP governs our own responses only, and no COEP is set.
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		-Server
		# reverse_proxy adds this itself; it says nothing a visitor needs. Also removed on the proxy's side below.
		-Via
	}

	# A second fence behind the service's own limits (server.mjs: 512 KiB for a family profile, less for the other routes). Nothing larger
	# is read from an API caller; the edge answers 413 for it.
	request_body /api/* {
		max_size 512KiB
	}

	log {
		output file /var/log/caddy/access.json {
			roll_disabled
		}
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>headers>Authorization delete
				request>headers>Cookie delete
				# Other headers (including forwarding headers), URI and host can also carry personal data.
				request>headers delete
				request>uri delete
				request>host delete
				resp_headers delete
			}
		}
	}

	reverse_proxy app:8787 {
		health_uri /healthz
		health_interval 30s
		header_down -Via
	}
}
